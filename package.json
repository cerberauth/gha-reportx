{
  "name": "@cerberauth/gha-reportx",
  "description": "Shared reportx CLI flag and PR-comment helpers for CerberAuth's reportx-based GitHub Actions",
  "version": "0.0.0",
  "author": "cerberauth",
  "type": "module",
  "license": "MIT",
  "repository": "cerberauth/gha-reportx",
  "homepage": "https://github.com/cerberauth/gha-reportx",
  "bugs": {
    "url": "https://github.com/cerberauth/gha-reportx/issues"
  },
  "keywords": [
    "actions",
    "reportx",
    "security",
    "cerberauth"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "npx rimraf ./dist && npx tsc",
    "ci-test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 npx jest",
    "lint": "npx eslint .",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check ."
  },
  "peerDependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1"
  },
  "devDependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.5.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.5",
    "@typescript-eslint/eslint-plugin": "8.69.0",
    "@typescript-eslint/parser": "8.69.0",
    "eslint": "10.10.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.6",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "jest": "30.5.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "ts-jest": "29.4.12",
    "ts-jest-resolver": "2.0.1",
    "typescript": "5.9.3"
  }
}
